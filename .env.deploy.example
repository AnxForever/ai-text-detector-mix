# === Backend (FastAPI) ===

# Model paths (relative to /app inside container)
DETECTOR_CLASSIFIER_MODEL=models/bert_v11c_boundary_fix
DETECTOR_SPAN_MODEL=models/bert_span_detector

# Inference settings
DETECTOR_MAX_LENGTH=256
DETECTOR_TEMPERATURE=0.8165
DETECTOR_DECISION_THRESHOLD=0.8

# CORS: comma-separated origins (use your domain in production)
# Example: http://your-domain.com,https://your-domain.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=0

# API protection
ENFORCE_INTERNAL_TOKEN=1
INTERNAL_API_TOKEN=change-this-token

# Risk observability fields in /api/detect response (0=off, 1=on)
DETECTOR_INCLUDE_RISK_OBSERVABILITY=0

# Request constraints and anti-abuse
DETECTOR_MAX_TEXT_CHARS=10000
RATE_LIMIT_WINDOW_SECONDS=60
DETECT_RATE_LIMIT_PER_WINDOW=60
CHAT_RATE_LIMIT_PER_WINDOW=20

# OpenAI-compatible API (for chat/rewrite features)
# Leave empty to disable chat endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_CHAT_MAX_MESSAGES=50
OPENAI_CHAT_MAX_TOKENS=2048
OPENAI_TIMEOUT_SECONDS=60
